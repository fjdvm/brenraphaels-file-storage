# Copy to .env.production and fill in. Never commit real values.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=br-file-storage-public
R2_PRIVATE_BUCKET=br-file-storage-private
R2_PUBLIC_BASE_URL=

# Neon pooled connection string (runtime)
DATABASE_URL=
# Neon direct connection string (migrations)
DATABASE_URL_UNPOOLED=

# Shared secret authorising the daily cleanup call (openssl rand -hex 32)
CRON_SECRET=
